PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookflow
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Single-business mode (one salon/clinic per install). Leave empty for the multi-business platform.
SINGLE_BUSINESS_SLUG=
# Live demo only: rebuild the demo businesses (npm run seed) once a day so their dates stay current.
# Never enable on a client's install.
DEMO_REFRESH=
