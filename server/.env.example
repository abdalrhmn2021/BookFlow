PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookflow
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Shared with the Vercel site (same value there). Lets the rate limits see each visitor's real IP.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=
# CLIENT_URL can be a comma-separated list: one shared server serves every client's site.
#   CLIENT_URL=https://laila-salon.vercel.app,https://reem-salon.vercel.app

# ---- Selling copies (see docs/INSTALL.md) ----
# Shared server for all your clients: set both to false. New clients are then added
# only with `npm run setup-client`, and nobody can list your clients.
ALLOW_BUSINESS_SIGNUP=true
PUBLIC_DIRECTORY=true
# Dedicated server for ONE client only (instead of a shared one): that client's slug.
SINGLE_BUSINESS_SLUG=

# ---- New-booking emails (optional) ----
# Sent through Brevo's HTTPS API (Render's free plan blocks SMTP ports, so Gmail SMTP won't work there).
# Free plan: 300 emails/day. Create an API key in Brevo -> SMTP & API -> API keys,
# and verify the sender address in Brevo -> Senders. Leave empty to turn the emails off.
BREVO_API_KEY=
MAIL_FROM=
# Shown as the sender's name; defaults to the business name.
MAIL_FROM_NAME=
