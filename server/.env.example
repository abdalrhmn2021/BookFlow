PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookflow
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Shared with the Vercel site (same value there). Lets the rate limits see each visitor's real IP.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_SECRET=
# Single-business mode (one salon/clinic per install). Leave empty for the multi-business platform.
SINGLE_BUSINESS_SLUG=
