PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookflow
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# How this server is installed (see src/config/mode.js). Leave all three empty for the demo platform.
# Dedicated server: one salon/clinic per server.
SINGLE_BUSINESS_SLUG=
# Shared server: ONE server for all sold copies (every client site sets its own SINGLE_BUSINESS_SLUG).
SHARED_SERVER=
# Same value on this server and on every client site (Vercel). Required with SHARED_SERVER=true.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_PROXY_SECRET=

# ---- New-booking emails (optional) ----
# Sent through Brevo's HTTPS API (Render's free plan blocks SMTP ports, so Gmail SMTP won't work there).
# Free plan: 300 emails/day. Create an API key in Brevo -> SMTP & API -> API keys,
# and verify the sender address in Brevo -> Senders. Leave empty to turn the emails off.
BREVO_API_KEY=
MAIL_FROM=
# Shown as the sender's name; defaults to the business name.
MAIL_FROM_NAME=

# ---- Automatic WhatsApp reminders (optional, see docs/INSTALL.md) ----
# Meta WhatsApp Cloud API. All three set = the job runs; then switch it on per client
# (npm run setup-client -- --whatsapp). Leave empty to keep it off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The approved template's name and language (4 body variables: customer, business, service, date/time).
WHATSAPP_TEMPLATE=booking_reminder
WHATSAPP_TEMPLATE_LANG=ar
# For local numbers like 0599123456 (a client can override it with --country-code).
WHATSAPP_DEFAULT_COUNTRY_CODE=970
# How long before the appointment (2-72, default 24) and how often the job checks (minutes).
REMINDER_HOURS_BEFORE=24
REMINDER_JOB_MINUTES=10
# Optional: lets an outside cron call POST /api/jobs/reminders (header x-jobs-secret).
# Needed on Render's free plan, which sleeps and stops the in-server timer.
JOBS_SECRET=
