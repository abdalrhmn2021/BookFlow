PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookflow
# Optional, tests only (npm test): a MongoDB replica set just for tests. Empty = an in-memory
# MongoDB is started for the tests. Tests never use MONGO_URI.
# MONGO_URI_TEST=
# Optional: DNS servers for the whole server (comma-separated), e.g. 8.8.8.8,1.1.1.1.
# Leave empty: in development a mongodb+srv:// address uses public DNS automatically.
DNS_SERVERS=
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# How this server is installed (see src/config/mode.js). Leave all three empty for the demo platform.
# Dedicated server: one salon/clinic per server.
SINGLE_BUSINESS_SLUG=
# Shared server: ONE server for all sold copies (every client site sets its own SINGLE_BUSINESS_SLUG).
SHARED_SERVER=
# Same value on this server and on every client site (Vercel). Required with SHARED_SERVER=true.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_PROXY_SECRET=

# ---- New-booking emails (optional) ----
# Sent through Brevo's HTTPS API (Render's free plan blocks SMTP ports, so Gmail SMTP won't work there).
# Free plan: 300 emails/day. Create an API key in Brevo -> SMTP & API -> API keys,
# and verify the sender address in Brevo -> Senders. Leave empty to turn the emails off.
BREVO_API_KEY=
MAIL_FROM=
# Shown as the sender's name; defaults to the business name.
MAIL_FROM_NAME=

# ---- Automatic WhatsApp reminders (optional, see docs/INSTALL.md) ----
# Meta WhatsApp Cloud API. All three set = the job runs; then switch it on per client
# (npm run setup-client -- --whatsapp). Leave empty to keep it off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The approved template's name and language (4 body variables: customer, business, service, date/time).
WHATSAPP_TEMPLATE=booking_reminder
WHATSAPP_TEMPLATE_LANG=ar
# For local numbers like 0599123456 (a client can override it with --country-code).
WHATSAPP_DEFAULT_COUNTRY_CODE=970
# How long before the appointment (2-72, default 24) and how often the job checks (minutes).
REMINDER_HOURS_BEFORE=24
REMINDER_JOB_MINUTES=10
# Optional: lets an outside cron call POST /api/jobs/reminders (header x-jobs-secret).
# Needed on Render's free plan, which sleeps and stops the in-server timer.
JOBS_SECRET=

# Server errors by email (review: monitoring). Your own email: every unexpected error (500) and
# failed background job sends you an email through Brevo (needs BREVO_API_KEY + MAIL_FROM),
# at most one every ALERT_EVERY_MINUTES (default 15). Empty = off.
ALERT_EMAIL=
# ALERT_EVERY_MINUTES=15

# The public demo business (npm run seed) is deleted and created again every DEMO_RESET_HOURS,
# so one visitor's changes don't stay for everyone after them. Empty or 0 = off (the default):
# set DEMO_RESET_HOURS=24 on the demo platform's server only, never on a client's copy.
# With JOBS_SECRET set, an outside cron can also call POST /api/jobs/demo-reset (does nothing if not due).
# DEMO_RESET_HOURS=24
# Most staff accounts one business can have (default 50).
# MAX_STAFF=50

# ---- AI booking assistant (optional) ----
# A chat on the booking page that answers about services, prices, hours and free times.
# Free key: https://aistudio.google.com/apikey . Set = available; then switch it on per business
# in /admin. Leave empty to keep it off.
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.5-flash-lite: fast and cheap).
GEMINI_MODEL=
# Most assistant messages one business answers per day (default 200). Every message is a call
# on your key, so this caps what someone with many IPs could spend on one business.
# ASSISTANT_MESSAGES_PER_DAY=200

# A pending booking nobody confirmed is cancelled automatically this many hours after it ends.
PENDING_AUTO_CLOSE_HOURS=24

# A guest's name, phone and notes are removed from a booking this many months after it (the
# booking itself stays). Use the SAME value on every client site (client DATA_RETENTION_MONTHS),
# because the privacy page tells customers this number. Default 12.
DATA_RETENTION_MONTHS=12

# ---- Protection against fake bookings (security review L-01, L-02) ----
# Cloudflare Turnstile ("are you a person?") on the guest booking form. Empty = off.
# Get the keys free at dash.cloudflare.com -> Turnstile; the site key goes on the client sites.
TURNSTILE_SECRET_KEY=
# Customers/guests can book at most this many days ahead (the business itself: no limit). Default 60.
BOOKING_MAX_DAYS_AHEAD=60
# New guest bookings per business per 24 hours. Default 30.
GUEST_BOOKINGS_PER_DAY=30
# "New booking" emails per business per 24 hours (all businesses share one Brevo account). Default 20.
NEW_BOOKING_EMAILS_PER_DAY=20
# Automatic WhatsApp reminders per business per 24 hours. Default 100.
WHATSAPP_REMINDERS_PER_DAY=100
