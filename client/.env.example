# Copy to .env.local and adjust
# Where the Express server runs (WITHOUT /api). next.config.ts forwards /api/* there,
# so the browser talks to ONE domain and the httpOnly login cookie works everywhere.
API_URL=http://localhost:5000
# Show the one-click demo login buttons (set to false in every copy you sell)
NEXT_PUBLIC_DEMO_MODE=true

# ---- Selling a copy to one business (white-label) ----
# All optional. Leave them empty to get the normal BookFlow platform.
# After changing any of these on Vercel, redeploy so they take effect.

# The business's slug (the one you gave `npm run setup-client`).
# "/" then opens its booking page, and the platform pages (directory, register a business) are hidden.
# On a dedicated server it must equal the server's SINGLE_BUSINESS_SLUG; on a shared server
# it is how the server knows which business this site is.
SINGLE_BUSINESS_SLUG=
# The SAME value as SITE_PROXY_SECRET on the server (secret - never NEXT_PUBLIC_).
# Required on a shared server. Also lets the server rate-limit each visitor by their real IP.
SITE_PROXY_SECRET=
# Name shown in the header, dashboard and browser tab (BRAND_NAME_AR is used in the Arabic UI).
BRAND_NAME=
BRAND_NAME_AR=
# Logo: a file in client/public (e.g. /brand/logo.png) or a full https:// URL. Also used as the tab icon.
BRAND_LOGO_URL=
# The client's main color as hex (e.g. #7c3aed). Buttons, highlights and links follow it.
BRAND_COLOR=
