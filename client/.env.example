# Copy to .env.local and adjust
# Where the Express server runs (WITHOUT /api). next.config.ts forwards /api/* there,
# so the browser talks to ONE domain and the httpOnly login cookie works everywhere.
API_URL=http://localhost:5000
# Show the one-click demo login buttons (set to false to hide them)
NEXT_PUBLIC_DEMO_MODE=true

# ---- Client edition (one install for one business) - leave empty for the multi-business platform ----
# Same value as the server's SINGLE_BUSINESS_SLUG: "/" opens this business's booking page
NEXT_PUBLIC_BUSINESS_SLUG=
# Name shown instead of "BookFlow"
NEXT_PUBLIC_BRAND_NAME=
# Price symbol (default ₪)
NEXT_PUBLIC_CURRENCY=
